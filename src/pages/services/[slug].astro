---
// One page per entry in src/data/services.js, at /services/<slug>/.
// The layout itself is in src/components/ServicePage.astro.
import ServicePage from '../../components/ServicePage.astro';
import { services } from '../../data/services.js';

export function getStaticPaths() {
  return Object.keys(services).map((slug) => ({ params: { slug } }));
}

const s = services[Astro.params.slug];
---
<ServicePage s={s} />
