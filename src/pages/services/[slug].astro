---
// One template for all six service pages. Text lives in src/data/services.js.
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services.js';

export function getStaticPaths() {
  return Object.keys(services).map((slug) => ({ params: { slug } }));
}

const s = services[Astro.params.slug];
---
<Base title={s.title.replace(/\.$/, '')} description={s.what}>
  <section style="margin-top:50px;">
    <div class="bg-blue" style="max-width:1320px;margin:0 auto;padding:clamp(50px,7vw,100px) 0;border-radius:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:24px;align-items:center;">
      <div data-reveal class="stack" style="padding:clamp(24px,4vw,50px);gap:20px;align-items:flex-start;">
        <h1 class="h1 white">{s.title}</h1>
        <p class="lead white">{s.subtitle}</p>
        <a href="/contact/" class="btn btn-lime">{s.button}</a>
      </div>
      <div data-reveal style="width:min(80%,300px);aspect-ratio:1;margin:0 auto;">
        <img src={s.image} alt="" style="width:100%;height:100%;object-fit:contain;display:block;" />
      </div>
    </div>
  </section>

  <section data-reveal style="margin-top:50px;">
    <div class="container stack" style="gap:16px;">
      <h2 class="h2">What We Do</h2>
      <p class="lead">{s.what}</p>
    </div>
  </section>

  <section style="margin:50px 0 70px;">
    <div class="container">
      <h2 data-reveal class="h2 gradient-text" style="display:inline-block;">Key Highlights</h2>
      <div style="margin-top:30px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:24px;">
        {s.highlights.map((hl) => (
          <div data-reveal class="hl-card">
            <div>
              <img src="/assets/img/marketing_sub_pages/check.svg" alt="" />
              <h3>{hl}</h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
