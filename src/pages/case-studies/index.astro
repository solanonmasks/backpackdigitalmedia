---
import Base from '../../layouts/Base.astro';
import { caseStudyList, getCaseStudy } from '../../data/caseStudies.js';
---
<Base title="Case Studies">
  <section class="bg-dark" style="padding:96px 0;">
    <div class="container-wide stack" style="gap:20px;">
      <p style="font-size:18px;color:var(--lime);text-transform:uppercase;letter-spacing:.06em;">Case Studies</p>
      <h1 style="font-size:clamp(40px,6vw,72px);font-weight:700;color:#fff;text-transform:uppercase;line-height:1;max-width:900px;">Here’s what it looked like for them.</h1>
    </div>
  </section>

  <section style="padding:96px 0;">
    <div class="container-wide stack" style="gap:32px;">
      {caseStudyList.map((c) => (
        <a href={`/case-studies/${c.slug}/`} data-reveal class="cs-row">
          {c.imageWide ? (
            <div class="shadow-img" style="overflow:hidden;">
              <img src={c.image} alt={c.imageAlt} loading="lazy" style="width:100%;height:auto;display:block;" />
            </div>
          ) : (
            <img src={c.image} alt={c.imageAlt} class="shadow-img" style="aspect-ratio:1/1;" loading="lazy" />
          )}
          <div class="stack" style="gap:20px;align-items:flex-start;">
            <p style="font-size:16px;color:var(--blue);text-transform:uppercase;font-weight:500;letter-spacing:.04em;">{c.descriptor || getCaseStudy(c.key).descriptor}</p>
            <h2 style="font-size:clamp(30px,3.2vw,44px);font-weight:700;text-transform:uppercase;line-height:1.02;text-wrap:balance;">{c.title}</h2>
            <div style="display:flex;flex-wrap:wrap;gap:12px;">
              {c.stats.map((st) => (
                <div class="stat-pill">
                  <span class="v">{st.before && <small>{st.before} →</small>} {st.after}</span>
                  <span class="l">{st.label}</span>
                </div>
              ))}
            </div>
            <span style="background:var(--ink);color:#fff;font-size:20px;padding:10px 22px;border-radius:999px;margin-top:8px;">Read the case study →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
