---
import Base from '../layouts/Base.astro';
import CtaPanel from '../components/CtaPanel.astro';

// ✏️ Core values
const values = [
  { icon: 1, title: 'Clarity:', text: 'We make it simple.' },
  { icon: 2, title: 'Collaboration:', text: 'We work as your partner.' },
  { icon: 3, title: 'Results:', text: 'We focus on what matters —your growth.' },
];

// ✏️ Team. Photos live in public/assets/img/home2/team/
// (Open item from the handoff: confirm Garik and Ramneek are still current.)
const team = [
  { photo: 1, name: 'Iqbal', role: 'President', bio: 'Iqbal is the founder of Backpack Digital Media. With 8+ years in the industry, he sets the strategic direction for the agency, ensuring we deliver impactful results for every client. His focus on collaboration and innovation is at the heart of everything we do.' },
  { photo: 2, name: 'Garik', role: 'Creative Director', bio: 'As Creative Director, Garik brings bold ideas to life. He leads the creative vision for all projects, ensuring our designs and campaigns don’t just look good but achieve results. Garik’s talent for turning ideas into engaging visuals makes him a driving force for client success.' },
  { photo: 3, name: 'Ramneek', role: 'Graphic Designer', bio: 'Ramneek is our go-to graphic designer who transforms concepts into stunning visuals. From branding materials to social media graphics, Ramneek combines creativity with precision to deliver designs that captivate and inspire.' },
  { photo: 4, name: 'Steven', role: 'Senior Account Manager', bio: 'Steven ensures our clients are always supported and their goals are achieved. With a strong background in client management and strategy, he’s the bridge between ideas and execution, ensuring projects stay on track and deliver results.' },
  { photo: 5, name: 'Ana', role: 'Finance Director', bio: 'Ana keeps Backpack Digital Media running smoothly behind the scenes. As Finance Director, she ensures every dollar spent drives value for our clients and the agency. Her sharp eye for numbers and strategic mindset keeps us grounded and growing.' },
  { photo: 6, name: 'Dan Ma', role: 'Partner Success Advisor', bio: 'Dan is the first person new clients meet and the one they keep hearing from. With years in local business advertising, he understands what owners actually need, builds the right plan with them, and stays on the account to make sure it delivers.' },
];
---
<Base title="About Us">
  <!-- Hero panel -->
  <section style="margin-top:50px;">
    <div style="max-width:1320px;margin:0 auto;background:#282828 url(/assets/img/home2/header/main.png) no-repeat center center;background-size:cover;padding:clamp(40px,7vw,100px) 0;border-radius:20px;display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:24px;align-items:center;">
      <div class="stack" style="padding:clamp(24px,4vw,50px);gap:24px;align-items:flex-start;">
        <h1 class="h1 white">Your partner in <span class="gradient-text">growth-focused</span> marketing.</h1>
        <a href="/contact/" class="btn btn-lime">Let's Grow Together</a>
      </div>
      <div style="width:80%;"><img src="/assets/img/home2/header/logo.svg" alt="" style="width:100%;display:block;" /></div>
    </div>
  </section>

  <!-- Who we are -->
  <section data-reveal style="margin-top:50px;">
    <div class="container stack" style="gap:16px;">
      <h2 class="h2">Who We Are</h2>
      <p class="lead">Backpack is a Vancouver marketing agency built by people who have spent their careers selling and building marketing for businesses of every kind. We run campaigns, content, websites and recruitment advertising for clients across Canada and the US, from restaurants and retailers to manufacturers, senior living operators and national employers, and for the past two years we have also been the production team behind other agencies, building the work they sell to their clients. That side of the business taught us to deliver on scope, on time, every time. The direct side is where we get to go deeper: learning a business from the inside, finding what makes it different, and building marketing around that instead of around a template.</p>
    </div>
  </section>

  <!-- Core values -->
  <section data-reveal style="margin-top:50px;">
    <div class="container stack" style="gap:24px;">
      <h2 class="h2">Core Values</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px;">
        {values.map((v) => (
          <div class="value-card">
            <div class="value-icon"><img src={`/assets/img/home2/values/${v.icon}.svg`} alt="" /></div>
            <div class="stack" style="margin-top:20px;gap:12px;">
              <h3>{v.title}</h3>
              <p class="lead white" style="line-height:normal;">{v.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section data-reveal class="bg-dark" style="margin-top:50px;padding:100px 0;">
    <div class="container">
      <div class="stack" style="max-width:1080px;margin:0 auto 50px;text-align:center;gap:24px;">
        <h2 class="h2 white">Meet the Team Behind Backpack Digital Media</h2>
        <p class="lead white" style="line-height:normal;">We’re a team of experts committed to helping your business grow through smart marketing and creative solutions.</p>
      </div>
      <div class="team-grid">
        {team.map((m) => (
          <div class="team-member">
            <div class="team-photo"><img src={`/assets/img/home2/team/${m.photo}.png`} alt={m.name} loading="lazy" /></div>
            <div class="team-info">
              <h3>{m.name}</h3>
              <p class="role">{m.role}</p>
              <hr />
              <p class="bio">{m.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaPanel variant="blue" />
</Base>
