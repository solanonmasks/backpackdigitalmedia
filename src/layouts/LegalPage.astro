---
// Layout for plain text pages written in Markdown, like the Privacy Policy
// and Terms. The page's title and description come from the top of its .md file.
import Base from './Base.astro';

const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <section style="padding:80px 0 100px;">
    <div class="container">
      <article class="legal">
        <slot />
      </article>
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 800px; }
  .legal :global(h1) { font-size: var(--fs-h1); font-weight: 500; color: #000; text-transform: uppercase; line-height: 1.1; margin-bottom: 24px; }
  .legal :global(h2) { font-size: 28px; font-weight: 700; text-transform: uppercase; line-height: 1.2; margin: 48px 0 16px; }
  .legal :global(p),
  .legal :global(li) { font-size: 19px; font-weight: 300; line-height: 1.6; }
  .legal :global(p + p) { margin-top: 16px; }
  .legal :global(ul) { margin: 16px 0 0; padding-left: 1.3em; list-style: disc; }
  .legal :global(li + li) { margin-top: 8px; }
  .legal :global(strong) { font-weight: 500; }
  .legal :global(a) { text-decoration: underline; }
</style>
