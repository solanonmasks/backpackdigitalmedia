---
// The layout shared by every service page. Pass one entry from
// src/data/services.js as `s`, e.g. <ServicePage s={services.seo} />
// Sections: hero, What we do, Key highlights, How we work, FAQ, links, closing CTA.
import Base from '../layouts/Base.astro';
import CtaPanel from './CtaPanel.astro';
import { howWeWork } from '../data/services.js';

const { s } = Astro.props;

// `what` can be one paragraph or a list of paragraphs.
const what = [].concat(s.what);
// A highlight can be plain text, or { title, text }.
const highlights = s.highlights.map((hl) => (typeof hl === 'string' ? { title: hl } : hl));
const cta = s.cta || {};

// Search title and description: use seoTitle / seoDescription from services.js
// when set, otherwise fall back to the page heading and intro text.
const seoTitle = s.seoTitle || s.title.replace(/\.$/, '');
const seoDescription = s.seoDescription || what[0];

// Structured data for Google. Only added for entries that have a `name` / `faq`.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const serviceSchema = s.name && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  description: seoDescription,
  url: pageUrl,
  provider: {
    '@type': 'ProfessionalService',
    name: 'Backpack Digital Media',
    url: 'https://www.backpackdigitalmedia.com',
  },
  areaServed: { '@type': 'City', name: 'Vancouver, BC' },
};
const faqSchema = s.faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={seoTitle} description={seoDescription}>
  {serviceSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  {faqSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Hero -->
  <section style="margin-top:50px;">
    <div class="bg-blue" style="max-width:1320px;margin:0 auto;padding:clamp(50px,7vw,100px) 0;border-radius:20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:24px;align-items:center;">
      <div data-reveal class="stack" style="padding:clamp(24px,4vw,50px);gap:20px;align-items:flex-start;">
        <h1 class="h1 white">{s.title}</h1>
        <p class="lead white">{s.subtitle}</p>
        <a href="/contact/" class="btn btn-lime">{s.button}</a>
      </div>
      {s.image && (
        <div data-reveal style="width:min(80%,300px);aspect-ratio:1;margin:0 auto;">
          <!-- If the entry has imageAnimated, show it unless the visitor has asked
               their device for reduced motion; they get the still image instead. -->
          <picture>
            {s.imageAnimated && <source srcset={s.imageAnimated} media="(prefers-reduced-motion: no-preference)" />}
            <img src={s.image} alt="" style="width:100%;height:100%;object-fit:contain;display:block;" />
          </picture>
        </div>
      )}
    </div>
  </section>

  <!-- What we do -->
  <section data-reveal style="margin-top:50px;">
    <div class="container stack" style="gap:16px;">
      <h2 class="h2">What we do</h2>
      {what.map((para) => <p class="lead">{para}</p>)}
    </div>
  </section>

  <!-- Results (optional): simple cards linking to case studies, no big numbers -->
  {s.results && (
    <section data-reveal style="margin-top:50px;">
      <div class="container stack" style="gap:30px;">
        <h2 class="h2">{s.results.title}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px;">
          {s.results.items.map((r) => (
            <a href={r.href} class="svc-card">
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <span class="more">Read the case study →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Key highlights -->
  <section style="margin:50px 0 70px;">
    <div class="container">
      <h2 data-reveal class="h2 gradient-text" style="display:inline-block;">Key highlights</h2>
      <div style="margin-top:30px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:24px;">
        {highlights.map((hl) => (
          <div data-reveal class="hl-card">
            <div>
              <img src="/assets/img/marketing_sub_pages/check.svg" alt="" />
              <h3>{hl.title}</h3>
              {hl.text && <p style="font-size:19px;font-weight:300;line-height:1.4;">{hl.text}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work (same on every service page; text in services.js) -->
  <section data-reveal class="bg-dark" style="padding:90px 0;">
    <div class="container stack" style="gap:20px;">
      <h2 class="h2 white">How we work</h2>
      <div class="steps">
        {howWeWork.map((step, i) => (
          <div class="step">
            <span class="n">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {s.faq && (
    <section data-reveal style="margin-top:100px;">
      <div class="container stack" style="gap:36px;">
        <h2 class="h2">Frequently asked questions</h2>
        {s.faq.map((f) => (
          <div class="stack" style="gap:10px;max-width:900px;">
            <h3 style="font-size:clamp(22px,2.2vw,28px);font-weight:500;color:#000;line-height:1.2;">{f.q}</h3>
            <p style="font-size:20px;font-weight:300;line-height:1.5;">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Links to the services overview and case studies -->
  <section data-reveal style="margin-top:70px;">
    <div class="container" style="display:flex;gap:12px;flex-wrap:wrap;">
      <a href="/digital-marketing/" class="pill btn-blue">See all our services</a>
      <a href="/case-studies/" class="pill btn-blue">See our case studies</a>
      {(s.extraLinks || []).map((l) => <a href={l.href} class="pill btn-blue">{l.label}</a>)}
    </div>
  </section>

  <CtaPanel variant="dark" title={cta.title} text={cta.text} button={cta.button} />
</Base>
